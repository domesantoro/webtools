  <diagram id="05" name="05 - Sistema interno">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t5" value="&lt;b&gt;SISTEMA INTERNO DELLA MICRO-FACTORY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=25;fontStyle=1;align=left;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="2720" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Agenti, skill e hook diventano utili solo se lavorano su uno stato e su artefatti condivisi, con contratti di input/output precisi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="105" width="2720" height="55" as="geometry" />
        </mxCell>
        <mxCell id="project" value="&lt;b&gt;PROJECT WORKSPACE&lt;/b&gt;&lt;br&gt;&lt;br&gt;/projects/{project_id}/&lt;br&gt;intake.json&lt;br&gt;transcript.md&lt;br&gt;context.snapshot.json&lt;br&gt;decision_log.jsonl&lt;br&gt;spec.draft.yaml&lt;br&gt;spec.frozen.yaml&lt;br&gt;acceptance.yaml&lt;br&gt;contract.pdf&lt;br&gt;build_plan.json&lt;br&gt;test_report.json&lt;br&gt;demo.json&lt;br&gt;deploy.json&lt;br&gt;metrics.json" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f8fafc;strokeColor=#475569;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="230" width="470" height="520" as="geometry" />
        </mxCell>
        <mxCell id="state5" value="&lt;b&gt;project_state.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;lead&lt;br&gt;booked&lt;br&gt;analysis_running&lt;br&gt;spec_draft&lt;br&gt;awaiting_signature&lt;br&gt;signed&lt;br&gt;building&lt;br&gt;demo_live&lt;br&gt;accepted / rejected / expired&lt;br&gt;awaiting_payment&lt;br&gt;paid&lt;br&gt;deploying&lt;br&gt;live&lt;br&gt;closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;fontColor=#312e81;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="230" width="420" height="520" as="geometry" />
        </mxCell>
        <mxCell id="orchestrator5" value="&lt;b&gt;ORCHESTRATOR&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. legge state + event&lt;br&gt;2. decide quale workflow attivare&lt;br&gt;3. seleziona agenti necessari&lt;br&gt;4. monta il context pack minimo&lt;br&gt;5. valida output schema&lt;br&gt;6. scrive artefatti / evento successivo&lt;br&gt;7. applica timeout e stop condition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="230" width="500" height="420" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="&lt;b&gt;AGENT REGISTRY&lt;/b&gt;&lt;br&gt;&lt;br&gt;agent_id&lt;br&gt;responsabilità&lt;br&gt;input_schema&lt;br&gt;output_schema&lt;br&gt;allowed_tools&lt;br&gt;skills[]&lt;br&gt;timeout&lt;br&gt;retry_policy&lt;br&gt;cost_limit&lt;br&gt;can_write[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;fontColor=#164e63;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1750" y="230" width="420" height="420" as="geometry" />
        </mxCell>
        <mxCell id="skillreg" value="&lt;b&gt;SKILL REGISTRY&lt;/b&gt;&lt;br&gt;&lt;br&gt;requirements.extract&lt;br&gt;workflow.model&lt;br&gt;scope.guard&lt;br&gt;feasibility.estimate&lt;br&gt;acceptance.design&lt;br&gt;security.baseline&lt;br&gt;project.scaffold&lt;br&gt;api.integrate&lt;br&gt;demo.package&lt;br&gt;deploy.preflight&lt;br&gt;deploy.execute&lt;br&gt;smoke.run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2250" y="230" width="420" height="420" as="geometry" />
        </mxCell>
        <mxCell id="hooks5" value="&lt;b&gt;EVENT / HOOK TABLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;on_intake_received → triage + missing info&lt;br&gt;on_slot_started → create transcript + timers&lt;br&gt;on_hour1_closed → context snapshot + crew analysis&lt;br&gt;on_spec_drafted → validators&lt;br&gt;on_spec_freeze → hash + contract vars + build handoff&lt;br&gt;on_contract_signed → build queue&lt;br&gt;on_build_started → 120&#39; watchdog&lt;br&gt;on_demo_published → expiry timer&lt;br&gt;on_demo_accepted → infrastructure instructions&lt;br&gt;on_payment_received → deploy queue&lt;br&gt;pre_deploy → environment checks&lt;br&gt;post_deploy → smoke + closeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="850" width="1200" height="470" as="geometry" />
        </mxCell>
        <mxCell id="guards5" value="&lt;b&gt;GUARDRAILS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• output schema obbligatorio&lt;br&gt;• context pack minimo per agente&lt;br&gt;• spec frozen read-only&lt;br&gt;• max retry per task = 1&lt;br&gt;• nessun loop agentico senza stop condition&lt;br&gt;• build watchdog hard-stop&lt;br&gt;• nessun deploy senza state=PAID&lt;br&gt;• ogni automazione scrive event log&lt;br&gt;• fallimento agente ≠ fallimento progetto: fallback manuale / stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="850" width="620" height="470" as="geometry" />
        </mxCell>
        <mxCell id="learn5" value="&lt;b&gt;LEARNING LOOP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Da metrics.json aggiorni:&lt;br&gt;• tempi reali per categoria&lt;br&gt;• cause di NO-GO&lt;br&gt;• cause di demo reject&lt;br&gt;• task che sforano&lt;br&gt;• stack che rallentano&lt;br&gt;• deploy che falliscono&lt;br&gt;• prompt/skill con più errori&lt;br&gt;&lt;br&gt;Output: modifica checklist, skill e soglie. Non riuso del prodotto: riuso del processo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2080" y="850" width="590" height="470" as="geometry" />
        </mxCell>
