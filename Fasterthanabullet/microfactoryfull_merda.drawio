        <mxCell id="sm_cl" edge="1" parent="1" source="smoke4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;" target="close4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="security4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" value="&lt;b&gt;Credenziali&lt;/b&gt;&lt;br&gt;mai via email in chiaro. Secure one-time form / secret manager. Dopo il deploy: revoke o elimina accessi temporanei." vertex="1">
          <mxGeometry height="140" width="950" x="250" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="payment4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" value="&lt;b&gt;Pagamento&lt;/b&gt;&lt;br&gt;Il deploy è tecnicamente impossibile finché project_state != PAID. Il controllo non è affidato alla memoria umana." vertex="1">
