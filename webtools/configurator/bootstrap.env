# Starting the subsystems: the only pieces of information that are NOT in the
# configuration, because they are what reaches it. Everything else is in
# configuration/*.json and anagraphics serves it (GET /configuration/{subsystem}).
#
# The control scripts (webtools_*.sh) and load_configuration.sh load it.
# No subsystem has default values: without these variables it does not start.

# Where anagraphics is. The others call it here; anagraphics gets from it the
# address and the port to listen on.
WEBTOOLS_ANAGRAPHICS_URL=http://127.0.0.1:9100

# How long to wait for anagraphics while reading the configuration, at startup.
WEBTOOLS_CONFIGURATION_TIMEOUT_MS=5000

# Anagraphics' database, where the `configuration` collection lives too.
WEBTOOLS_MONGO_URI=mongodb://localhost:27017
WEBTOOLS_MONGO_DB=webtools
