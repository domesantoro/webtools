# Avvio dei sottosistemi: le sole informazioni che NON stanno nella
# configurazione, perché servono a raggiungerla. Tutto il resto sta in
# configuration/*.json e lo serve anagraphics (GET /configuration/{subsystem}).
#
# Lo caricano gli script di controllo (webtools_*.sh) e load_configuration.sh.
# Nessun sottosistema ha valori di default: senza queste variabili non parte.

# Dove sta anagraphics. Gli altri lo chiamano qui; anagraphics ne ricava
# l'indirizzo e la porta su cui mettersi in ascolto.
WEBTOOLS_ANAGRAPHICS_URL=http://127.0.0.1:8100

# Quanto aspettare anagraphics mentre si legge la configurazione, all'avvio.
WEBTOOLS_CONFIGURATION_TIMEOUT_MS=5000

# Il database di anagraphics, dove sta anche la collection `configuration`.
WEBTOOLS_MONGO_URI=mongodb://localhost:27017
WEBTOOLS_MONGO_DB=webtools
