      },
      "policy": "analysis-technical-v1",
      "stack_preferences": {
        "web": {
          "language": "JavaScript, Node.js 22 LTS",
          "http": "Express 5",
          "pages": "server-rendered Nunjucks templates, autoescape on",
          "browser": "no client framework; plain CSS, and vanilla JavaScript only where a page cannot work without it",
          "store": "SQLite, one file beside the application, through node:sqlite",
          "tests": "node:test"
        }
      }
    },
    "judgement": {
      "provider": "anthropic",
      "timeout_ms": 2400000,
      "max_attempts": 3,
      "providers": {
        "anthropic": {
          "model": "claude-opus-5",
          "max_tokens": 16000,
          "effort": "high"
        }
      },
      "policy": "analysis-sustainability-v1",
      "take_on_threshold": 0.5
    },
    "points": {
      "provider": "anthropic",
      "timeout_ms": 2400000,
      "max_attempts": 3,
      "providers": {
        "anthropic": {
          "model": "claude-opus-5",
          "max_tokens": 16000,
