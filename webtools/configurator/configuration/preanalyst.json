{
  "listen": {
    "host": "127.0.0.1",
    "port": 9200
  },
  "public_url": "http://127.0.0.1:9200",
  "subsystems_infos": {
    "anagraphics": {
      "timeout_ms": 5000
    },
    "sso": {
      "url": "http://127.0.0.1:9300",
      "timeout_ms": 5000
    },
    "workspaces": {
      "url": "http://127.0.0.1:9400",
      "timeout_ms": 5000
    },
    "front_gate": {
      "url": "http://127.0.0.1:9000"
    }
  },
  "session": {
    "cookie_name": "webtools_preanalyst"
  },
  "form": {
    "body_max_bytes": 524288,
    "answer_max_chars": 20000
  },
  "upload": {
    "max_bytes": 10485760,
    "accept": ".md"
  },
  "prevalidation": {
    "provider": "anthropic",
    "timeout_ms": 20000,
    "providers": {
      "anthropic": {
        "model": "claude-haiku-4-5",
        "max_tokens": 512
      }
    },
    "policy": "scope-v1",
    "reject_threshold": 0.6,
    "max_underspecified_attempts": 100,
    "spec_max_chars": 20000,
    "rejection_reason_in_pdf": false
  },
  "analysis": {
    "max_turns": 30,
    "warn_from_turn": 20
  },
  "analyst": {
    "conversation": {
      "provider": "anthropic",
      "timeout_ms": 120000,
      "providers": {
        "anthropic": {
          "model": "claude-opus-5",
          "max_tokens": 16000,
          "effort": "medium",
          "operator_channel": "system_message"
        }
      },
      "policy": "analysis-v1",
      "message_max_chars": 4000
    },
    "validation": {
      "provider": "anthropic",
      "timeout_ms": 120000,
      "providers": {
        "anthropic": {
          "model": "claude-opus-5",
          "max_tokens": 16000,
          "effort": "high",
          "operator_channel": "system_message"
        }
      },
      "policy": "analysis-validation-v1",
      "pass_threshold": 0.75
    }
  },
  "i18n": {
    "locales": [
      "en",
      "it"
    ],
    "fallback_locale": "en",
    "cookie_name": "webtools_locale",
    "cookie_max_age_seconds": 31536000,
    "body_max_bytes": 1024
  }
}
