{
  "listen": {
    "host": "127.0.0.1",
    "port": 9600
  },
  "access": {
    "allowed_ips": ["127.0.0.1", "::1"]
  },
  "mongo": {
    "server_selection_timeout_ms": 30000
  },
  "limits": {
    "retention_days": 90,
    "body_max_bytes": 8192,
    "max_rows": 500,
    "duration_buckets_ms": [1000, 5000, 15000, 30000, 60000, 120000, 300000]
  },
  "subsystems_infos": {
    "anagraphics": {
      "timeout_ms": 5000
    }
  },
  "providers": {
    "anthropic": {
      "token_kinds": ["input", "output", "cache_write", "cache_read"]
    }
  }
}
