{
  "listen": {
    "host": "127.0.0.1",
    "port": 9700
  },
  "access": {
    "allowed_ips": ["127.0.0.1", "::1"]
  },
  "subsystems_infos": {
    "metrics": {
      "url": "http://127.0.0.1:9600",
      "timeout_ms": 10000
    }
  },
  "period": {
    "default_days": 30,
    "presets_days": [1, 7, 30, 90, 365]
  },
  "limits": {
    "top_rows": 25,
    "series_metrics": 6,
    "ring_slices": 5
  }
}
