{% extends "layout.njk" %}
{% set page = "che-cos-e" %}
{% set title = t("front_gate.what.title") %}
{% set description = t("front_gate.what.description") %}

{% block main %}
<main class="page-main">
  <section class="container page-intro wide reveal"><div class="eyebrow">{{ t("front_gate.what.eyebrow") }}</div><h1>{{ t("front_gate.what.heading") }}</h1><p>{{ t("front_gate.what.lead") }}</p></section>

  <section class="container split-section">
    <div class="device-stage reveal delay-1" aria-hidden="true">
      <div class="card browser-panel"><div class="card-head browser-bar"><span class="window-dots"><i></i><i></i><i></i></span><div class="url-pill">{{ t("front_gate.what.url") }}</div></div><div class="browser-content"><div class="headline-bar"></div><div class="copy-bar"></div><div class="board"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div></div>
      <div class="card phone-panel"><div class="phone-notch"></div><div class="phone-line short"></div><div class="phone-line"></div><div class="phone-list"><i></i><i></i><i></i><i></i></div></div>
    </div>
    <div class="split-copy reveal">
      <h2>{{ t("front_gate.what.not_an_app.heading") }}</h2>
      <p>{{ t("front_gate.what.not_an_app.text1") }}</p>
      <p>{{ t("front_gate.what.not_an_app.text2") }}</p>
      <ul><li>{{ t("front_gate.what.not_an_app.points.link") }}</li><li>{{ t("front_gate.what.not_an_app.points.need") }}</li><li>{{ t("front_gate.what.not_an_app.points.lean") }}</li><li>{{ t("front_gate.what.not_an_app.points.source") }}</li></ul>
    </div>
  </section>

  <section class="section section-line"><div class="container"><div class="section-head"><h2>{{ t("front_gate.what.scale.heading") }}</h2><p>{{ t("front_gate.what.scale.text") }}</p></div><div class="scale-grid"><article class="scale-item"><span>01</span><h3>{{ t("front_gate.what.scale.need.title") }}</h3><p>{{ t("front_gate.what.scale.need.text") }}</p></article><article class="scale-item"><span>02</span><h3>{{ t("front_gate.what.scale.scope.title") }}</h3><p>{{ t("front_gate.what.scale.scope.text") }}</p></article><article class="scale-item"><span>03</span><h3>{{ t("front_gate.what.scale.no_platform.title") }}</h3><p>{{ t("front_gate.what.scale.no_platform.text") }}</p></article></div></div></section>

  <section class="section"><div class="container value-band"><div class="big-price"><small>{{ t("front_gate.what.practice.label") }}</small>{{ t("front_gate.what.practice.value") }}</div><div><p>{{ t("front_gate.what.practice.text") }}</p><a class="text-link" href="esempi.html">{{ t("front_gate.what.practice.link") }} <span>→</span></a></div></div></section>
</main>
{% endblock %}
