{% extends "layout.njk" %}
{% set page = "esempi" %}
{% set title = t("front_gate.examples.title") %}
{% set description = t("front_gate.examples.description") %}

{% block main %}
<main class="page-main">
  <section class="container page-intro wide reveal"><div class="eyebrow">{{ t("front_gate.examples.eyebrow") }}</div><h1>{{ t("front_gate.examples.heading") }}</h1><p>{{ t("front_gate.examples.lead") }}</p></section>
  <section class="container examples-grid">
    <article class="example-card wide"><h2>{{ t("front_gate.examples.cellar.title") }}</h2><p>{{ t("front_gate.examples.cellar.text") }}</p><div class="card card-sm example-visual"><div class="card-head visual-head"><b>{{ t("front_gate.index.stage.brand") }}</b><span>{{ t("front_gate.examples.cellar.count") }}</span></div><div class="wine-layout"><div class="wine-list"><div class="wine-entry"><b>Barbera d’Asti</b><span>2021</span></div><div class="wine-entry"><b>Etna Rosso</b><span>2020</span></div><div class="wine-entry"><b>Verdicchio</b><span>2022</span></div><div class="wine-entry"><b>Brunello</b><span>2018</span></div></div><div class="wine-detail"><div class="bottle"></div><div class="detail-bars"><i></i><i style="width:78%"></i><i style="width:54%"></i></div></div></div></div></article>

    <article class="example-card"><h2>{{ t("front_gate.index.league.title") }}</h2><p>{{ t("front_gate.examples.league.text") }}</p><div class="card card-sm example-visual"><div class="card-head visual-head"><b>{{ t("front_gate.examples.league.head") }}</b><span>{{ t("front_gate.examples.league.round") }}</span></div><div class="bracket"><div class="round"><div class="match"><b>Dora 3</b>San Paolo 1</div><div class="match"><b>Officine 2</b>Balon 2</div></div><div class="round"><div class="match"><b>Dora 2</b>Balon 0</div></div><div class="round"><div class="match"><b>{{ t("front_gate.examples.league.final") }}</b>{{ t("front_gate.examples.league.final_time") }}</div></div></div></div></article>

    <article class="example-card"><h2>{{ t("front_gate.examples.library.title") }}</h2><p>{{ t("front_gate.examples.library.text") }}</p><div class="card card-sm example-visual"><div class="card-head visual-head"><b>{{ t("front_gate.examples.library.head") }}</b><span>{{ t("front_gate.examples.library.count") }}</span></div><div class="library-shelf"><i class="book"></i><i class="book"></i><i class="book"></i><i class="book"></i><i class="book"></i><i class="book"></i></div></div></article>

    <article class="example-card"><h2>{{ t("front_gate.examples.garage.title") }}</h2><p>{{ t("front_gate.examples.garage.text") }}</p><div class="card card-sm example-visual"><div class="card-head visual-head"><b>{{ t("front_gate.examples.garage.head") }}</b><span>Fiat Panda</span></div><div class="maintenance"><div class="odometer">084.620</div><div class="maint-row"><span>{{ t("front_gate.examples.garage.date1") }}</span><strong>{{ t("front_gate.examples.garage.oil") }}</strong><span>{{ t("front_gate.examples.garage.km1") }}</span></div><div class="maint-row"><span>{{ t("front_gate.examples.garage.date2") }}</span><strong>{{ t("front_gate.examples.garage.tyres") }}</strong><span>{{ t("front_gate.examples.garage.km2") }}</span></div><div class="maint-row"><span>{{ t("front_gate.examples.garage.date3") }}</span><strong>{{ t("front_gate.examples.garage.inspection") }}</strong><span>{{ t("front_gate.examples.garage.km3") }}</span></div></div></div></article>

    <article class="example-card wide"><h2>{{ t("front_gate.examples.quote.title") }}</h2><p>{{ t("front_gate.examples.quote.text") }}</p><div class="card card-sm example-visual"><div class="card-head visual-head"><b>{{ t("front_gate.examples.quote.head") }}</b><span>{{ t("front_gate.examples.quote.new") }}</span></div><div class="quote-builder"><div class="quote-form"><div class="fake-input">{{ t("front_gate.examples.quote.kind") }}</div><div class="fake-input">{{ t("front_gate.examples.quote.hours") }}</div><div class="fake-input">{{ t("front_gate.examples.quote.materials") }}</div><div class="fake-input">{{ t("front_gate.examples.quote.travel") }}</div></div><div class="quote-total"><span>{{ t("front_gate.examples.quote.total") }}</span><b>{{ t("front_gate.examples.quote.amount") }}</b><i></i><i style="width:72%"></i><i style="width:46%"></i></div></div></div></article>

    <article class="example-card"><h2>{{ t("front_gate.examples.shifts.title") }}</h2><p>{{ t("front_gate.examples.shifts.text") }}</p><div class="card card-sm example-visual"><div class="card-head visual-head"><b>{{ t("front_gate.examples.shifts.head") }}</b><span>{{ t("front_gate.examples.shifts.week") }}</span></div><div class="shift-table"><span></span><span>{{ t("front_gate.examples.shifts.days.mon") }}</span><span>{{ t("front_gate.examples.shifts.days.tue") }}</span><span>{{ t("front_gate.examples.shifts.days.wed") }}</span><span>{{ t("front_gate.examples.shifts.days.thu") }}</span><span>{{ t("front_gate.examples.shifts.days.fri") }}</span><span>Anna</span><span class="on">✓</span><span class="on">✓</span><span></span><span class="on">✓</span><span></span><span>Luca</span><span></span><span class="on">✓</span><span class="on">✓</span><span></span><span class="on">✓</span><span>Vale</span><span class="on">✓</span><span></span><span class="on">✓</span><span class="on">✓</span><span></span></div></div></article>

    <article class="example-card"><h2>{{ t("front_gate.examples.inventory.title") }}</h2><p>{{ t("front_gate.examples.inventory.text") }}</p><div class="card card-sm example-visual"><div class="card-head visual-head"><b>{{ t("front_gate.examples.inventory.head") }}</b><span>{{ t("front_gate.examples.inventory.count") }}</span></div><div class="inventory-map"><div class="bin"><b>{{ t("front_gate.examples.inventory.shelf_a") }}</b>{{ t("front_gate.examples.inventory.shelf_a_items") }}</div><div class="bin"><b>{{ t("front_gate.examples.inventory.shelf_b") }}</b>{{ t("front_gate.examples.inventory.shelf_b_items") }}</div><div class="bin"><b>{{ t("front_gate.examples.inventory.drawers") }}</b>{{ t("front_gate.examples.inventory.drawers_items") }}</div><div class="bin"><b>{{ t("front_gate.examples.inventory.consumables") }}</b>{{ t("front_gate.examples.inventory.consumables_items") }}</div></div></div></article>

    <article class="example-card"><h2>{{ t("front_gate.examples.garden.title") }}</h2><p>{{ t("front_gate.examples.garden.text") }}</p><div class="card card-sm example-visual"><div class="card-head visual-head"><b>{{ t("front_gate.examples.garden.head") }}</b><span>{{ t("front_gate.examples.garden.month") }}</span></div><div class="garden-calendar"><span>1</span><span>2</span><span class="grow">3</span><span>4</span><span>5</span><span class="grow">6</span><span>7</span><span class="grow">8</span><span>9</span><span>10</span><span>11</span><span>12</span><span class="grow">13</span><span>14</span><span>15</span><span>16</span><span class="grow">17</span><span>18</span><span>19</span><span>20</span><span>21</span></div></div></article>

    <article class="example-card wide"><h2>{{ t("front_gate.examples.docs.title") }}</h2><p>{{ t("front_gate.examples.docs.text") }}</p><div class="card card-sm example-visual"><div class="card-head visual-head"><b>{{ t("front_gate.examples.docs.head") }}</b><span>{{ t("front_gate.examples.docs.pending_count") }}</span></div><div class="docs-sorter"><div class="docs-inbox"><div class="file-chip"><b>{{ t("front_gate.examples.docs.file_minutes") }}</b><br>{{ t("front_gate.examples.docs.pending") }}</div><div class="file-chip"><b>{{ t("front_gate.examples.docs.file_invoice") }}</b><br>{{ t("front_gate.examples.docs.pending") }}</div><div class="file-chip"><b>{{ t("front_gate.files.meter_photo") }}</b><br>{{ t("front_gate.examples.docs.pending") }}</div></div><div class="docs-out"><div class="file-chip"><b>→ {{ t("front_gate.files.minutes_category") }}</b><br>{{ t("front_gate.examples.docs.minutes_note") }}</div><div class="file-chip"><b>→ {{ t("front_gate.files.administration") }}</b><br>{{ t("front_gate.examples.docs.administration_note") }}</div><div class="file-chip"><b>→ {{ t("front_gate.files.property") }}</b><br>{{ t("front_gate.examples.docs.property_note") }}</div></div></div></div></article>
  </section>
</main>
{% endblock %}
