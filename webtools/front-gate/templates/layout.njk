{#-
  The shell of every page of the showcase site: head, header, footer.
  The page extends it and sets, outside the blocks:
    page         the page's name (`esempi`, `contatti`, …): it highlights its item
                 in the menu and removes the link to itself from the footer
    title        the <title>
    description  the meta description
  and fills the `main` block.

  The texts live in the catalogues (webtools/commons/i18n/locales/), under
  `front_gate.*`; `t`, `locale` and the language switcher are given by
  `i18n.pageContext` (src/page.js).
-#}
<!doctype html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" href="assets/mark.svg" type="image/svg+xml">
  <link rel="stylesheet" href="css/commons.css">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body>
<div class="site-shell">
{% include "partials/header.njk" %}
{% block main %}{% endblock %}
{% include "partials/footer.njk" %}
</div>
<script src="js/main.js"></script>
</body>
</html>
