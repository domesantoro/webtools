{% extends "commons/base.njk" %}
{#- `with context`: i macro usano `t` e le altre funzioni della lingua. #}
{% import "macros/fields.njk" as campi with context %}
{% import "partials/driver_box.njk" as box with context %}
{% import "partials/ambassador_box.njk" as invito with context %}
{% import "partials/access.njk" as accesso with context %}
{% import "partials/driver_work.njk" as lavoro with context %}
{% import "partials/upload_box.njk" as caricamento with context %}

{#
  La pagina della pre-analisi.

  Due blocchi affiancati: a sinistra il testo e il form (le domande vengono da
  `src/questions.js`), a destra il box del driver, che compare solo se il link ne
  portava uno. Senza box la colonna è una sola e il form si stringe, o le righe
  diventano illeggibili.

  La tendina del driver sta FUORI dal form e ci si aggancia con `form="gate-form"`:
  così il box resta autonomo ma quello che porta viaggia insieme alle risposte.
#}

{#- Lo stato dell'accesso e l'indirizzo del login stanno sul <body>: li legge
    sso_popup.js, e servono a chi deve aprire il login da codice e a chi deve
    sapere se aprire la modale del login (gate.js, upload.js). #}
{% block body_attributes %}{% if access.logged %} data-sso-logged{% endif %} data-sso-login-url="{{ access.login_url }}"{% endblock %}

{% block header_extra %}
      <div class="header-access" data-sso-header>
      {{- accesso.header(access) }}
      </div>
{% endblock %}

{% block main %}
    <div class="container gate">
      <div class="gate-intro reveal">
        <div class="eyebrow">{{ t("preanalyst.page.eyebrow") }}</div>
        <h1>{{ t("preanalyst.page.heading") }}</h1>
        <p class="gate-lead">{{ t("preanalyst.page.lead") }}</p>
      </div>

      <div class="gate-layout">
        <div class="gate-main reveal delay-1">
          {#- Senza `novalidate`: il browser controlla da sé i campi obbligatori
              prima di mandare il form. Il server li ricontrolla comunque. #}
          <form class="gate-form" id="gate-form" method="post" action="/submit">
            {#- L'id di questo invio: se il form arriva due volte, il progetto resta uno. #}
            <input type="hidden" name="submission_id" value="{{ submission_id }}">
            {%- for sezione in sections %}
            {{ campi.section(sezione) }}
            {%- endfor %}

            <div class="form-actions">
              {#- La pre-analisi si compila anche da sloggati: il conto serve per
                  mandarla. Da sloggati il clic apre la modale del login
                  (gate.js); senza JavaScript il server risponde che serve
                  l'accesso. #}
              <button class="btn btn-primary" type="submit">{{ t("preanalyst.page.submit") }}</button>
            </div>
          </form>
        </div>

        {#- La colonna destra. I blocchi del driver stanno in un contenitore a
            parte perché il browser li rimpiazza dopo il login: il blocco del
            caricamento resta fuori, o si porterebbe via il file già scelto. #}
        <div class="gate-aside">
          <div data-sso-driver>
          {%- if aside.driver_box.show %}{{ box.render(aside.driver_box) }}{% endif %}
          {%- if aside.ambassador_box.show %}{{ invito.render(aside.ambassador_box) }}{% endif %}
          {%- if aside.driver_work.show %}{{ lavoro.render(aside.driver_work) }}{% endif %}
          </div>
          {{ caricamento.render(upload) }}
        </div>
      </div>

      {#- Le modali del login, fuori dal form: dentro hanno un loro <form> per
          chiudersi, e i form non si annidano. #}
      {{ accesso.dialog(access, "login-dialog-submit",
           t("preanalyst.dialogs.submit.lead"), t("preanalyst.dialogs.submit.hint")) }}
      {{ accesso.dialog(access, "login-dialog-upload",
           t("preanalyst.dialogs.upload.lead"), t("preanalyst.dialogs.upload.hint")) }}
    </div>
{% endblock %}

{% block scripts %}
<script src="/sso_popup.js" defer></script>
<script src="/gate.js" defer></script>
<script src="/upload.js" defer></script>
{% endblock %}
