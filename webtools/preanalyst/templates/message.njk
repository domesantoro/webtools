{% extends "commons/base.njk" %}

{#
  A page with a single message: the outcome of a submission that went wrong, or an
  analysis that cannot be shown. The texts live in the catalogues, under
  `preanalyst.messages.<kind>`.
#}

{% block main %}
    <div class="container gate done">
      <div class="done-card card">
        <div class="card-head">{{ message.title }}</div>
        <div class="done-body">
          <p class="done-lead">{{ message.text }}</p>
          <p class="done-alt">
            <a class="text-link" href="/">{{ t("preanalyst.messages.back") }}</a>
          </p>
        </div>
      </div>
    </div>
{% endblock %}
