{% extends "commons/base.njk" %}

{#
  The small page that closes the login round trip.

  The **login window** lands here, not the starting page: by now the ticket has
  been exchanged and the cookie set. The script (`/sso_popup.js`, loaded by the
  block at the bottom) notifies the window that opened it and closes this one.

  The text is for the cases where the closing does not happen: JavaScript off, a
  window opened by hand, or something gone wrong. No window should be left
  speechless.
#}

{% block body_attributes %} data-sso-login-done{% endblock %}

{% block main %}
    <div class="container gate done">
      <div class="done-card card">
        <div class="card-head">{{ t("preanalyst.login_done.ok_head") if ok else t("preanalyst.login_done.failed_head") }}</div>
        <div class="done-body">
          {%- if ok %}
          <p class="done-lead">{{ t("preanalyst.login_done.ok_text") }}</p>
          {%- else %}
          <p class="notice notice-warn">{{ t("preanalyst.login_done.failed_text") }}</p>
          {%- endif %}
          <p class="done-alt">
            <a class="text-link" href="/">{{ t("preanalyst.login_done.back") }}</a>
          </p>
        </div>
      </div>
    </div>
{% endblock %}

{% block scripts %}
<script src="/sso_popup.js" defer></script>
{% endblock %}
