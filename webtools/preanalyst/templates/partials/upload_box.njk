{#
  The block for uploading an analysis that is already done: a .md file carrying in
  its front matter the `project_id` of a project belonging to whoever uploads it.
  Always visible, even when logged out: the account is needed at the moment of
  uploading, not to choose the file — logged out, "Carica" opens the login modal,
  which lives in page.njk.

  Without JavaScript only the file field is left: the "Carica" button is brought up
  by `public/upload.js`, which is also what sends the file to `POST /upload`.
#}

{% macro render(upload) %}
      {#- The messages for upload.js: the browser has no catalogues, it gets them from here. #}
      <aside class="card upload-box" aria-labelledby="upload-box-title"
             data-upload-messages="{{ upload.messages | dump }}">
        <div class="card-head aside-head" id="upload-box-title">{{ t("preanalyst.upload.title") }}</div>
        <div class="upload-box-body">
          <p class="upload-lead">{{ t("preanalyst.upload.lead") }}</p>

          <label class="dropzone" for="analysis-file" data-upload-zone>
            <input class="dropzone-input" type="file" id="analysis-file" name="analysis"
                   accept="{{ upload.accept }}">
            <span class="dropzone-text" data-upload-name>{{ t("preanalyst.upload.choose") }}</span>
            <span class="dropzone-hint">{{ t("preanalyst.upload.limit", { mb: upload.max_mb }) }}</span>
          </label>

          {#- It appears only once a file has been chosen. #}
          <div class="upload-actions" data-upload-actions hidden>
            <button class="btn btn-primary" type="button" data-upload-send>{{ t("preanalyst.upload.send") }}</button>
            <button class="btn" type="button" data-upload-clear>{{ t("preanalyst.upload.clear") }}</button>
          </div>

          <p class="upload-status" data-upload-status role="status"></p>
        </div>
      </aside>
{%- endmacro %}
