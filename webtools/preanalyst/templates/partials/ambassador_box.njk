{#
  The ambassador box: the driver who invited the user to use webtools. It appears
  only if the ambassador has been recognised and nothing else says who brings the
  project (src/ambassador.js). With autonomous work ticked the CSS hides it (the
  `:has()` rule in styles.css).

  The hidden field carries the uid to the submission, where it is checked again. It
  is not there when the form comes back (`locked`): the project's ambassador was
  already recorded at the first submission, and that round does not read it
  again.
#}

{% macro render(ambassador) %}
      <aside class="card ambassador-box" aria-labelledby="ambassador-box-title">
        <div class="card-head aside-head" id="ambassador-box-title">{{ t("preanalyst.ambassador_box.title") }}</div>
        <div class="driver-box-body">
          <p class="driver-name">{{ ambassador.driver.screen_name }}</p>
          <p class="driver-box-lead">{{ t("preanalyst.ambassador_box.lead") }}</p>
          {%- if not ambassador.locked %}
          <input type="hidden" name="ambassador" value="{{ ambassador.driver.uid }}" form="gate-form">
          {%- endif %}
        </div>
      </aside>
{%- endmacro %}
