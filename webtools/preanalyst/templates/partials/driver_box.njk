{#
  The driver box: it appears only if the link carried one (`?discount=` or
  `?driver=`).

  The driver is not chosen from here: either the link brings one, or we assign one.
  The box says who it is, or why that link came to nothing.

  The states come from `src/driver_link.js`. What arrived in the URL stays attached
  to the form as a hidden field even when it could not be resolved: if the failure
  is ours, the user must not pay for it with a lost discount.
#}

{% macro render(box) %}
      <aside class="card driver-box" aria-labelledby="driver-box-title">
        <div class="card-head aside-head" id="driver-box-title">{{ t("preanalyst.driver_box.title") }}</div>
        <div class="driver-box-body">
          {%- if box.resolved %}
          <p class="driver-name">{{ box.link.driver.screen_name }}</p>
          <p class="driver-box-lead">{{ t("preanalyst.driver_box.resolved_lead") }}</p>
          {%- else %}
          <p class="driver-box-lead">{{ t("preanalyst.driver_box.lead") }}</p>
          {%- endif %}

          {#- Sentences with a name or a code inside use `t_html`: the markup is in
              the catalogue, the value is cleaned by t_html. #}
          {%- if not box.drivers_available %}
          <p class="notice notice-warn">{{ t("preanalyst.driver_box.drivers_unavailable") }}</p>
          {%- elif box.link.state == "discount_applied" %}
          <p class="notice notice-ok">{{ t_html("preanalyst.driver_box.discount_applied", { percentage: box.link.percentage }) }}</p>
          {%- elif box.link.state == "discount_expired" %}
          <p class="notice notice-warn">{{ t("preanalyst.driver_box.discount_expired") }}</p>
          {%- elif box.link.state == "discount_driver_missing" %}
          {%- set chi %}{% if box.link.driverName %}<strong>{{ box.link.driverName }}</strong>
            {%- elif box.link.driverUid %}<code>{{ box.link.driverUid }}</code>
            {%- else %}{{ t("preanalyst.driver_box.link_driver") }}{% endif %}{% endset %}
          <p class="notice notice-warn">{{ t_html("preanalyst.driver_box.discount_driver_missing", { driver: chi | safe }) }}</p>
          {%- elif box.link.state == "discount_driver_disabled" %}
          <p class="notice notice-warn">{{ t_html("preanalyst.driver_box.discount_driver_disabled", { name: box.link.driver.screen_name }) }}</p>
          {%- elif box.link.state == "driver_disabled" %}
          <p class="notice notice-warn">{{ t_html("preanalyst.driver_box.driver_disabled", { name: box.link.driver.screen_name }) }}</p>
          {%- elif box.link.state == "driver_unknown" %}
          <p class="notice notice-warn">
            {%- if box.link.driverUid %}{{ t_html("preanalyst.driver_box.driver_unknown_with_uid", { uid: box.link.driverUid }) }}
            {%- else %}{{ t("preanalyst.driver_box.driver_unknown") }}{% endif -%}
          </p>
          {%- endif %}

          {%- if box.can_be_ignored %}
          {#- It appears only when the driver ticks "autonomous work": the CSS
              switches it on with `:has()`, with no JavaScript and no reload.
              It says which of the two things will not be applied, not "what is
              above here": the reader must know what they are losing. #}
          <p class="notice notice-warn ignored-note">
            {%- if box.link.state == "discount_applied" %}
            {{ t("preanalyst.driver_box.ignored_discount", { name: box.link.driver.screen_name }) }}
            {%- else %}
            {{ t("preanalyst.driver_box.ignored_driver", { name: box.link.driver.screen_name }) }}
            {%- endif %}
          </p>
          {%- endif %}

          {%- for campo in box.hidden %}
          <input type="hidden" name="{{ campo.name }}" value="{{ campo.value }}" form="gate-form">
          {%- endfor %}
        </div>
      </aside>
{%- endmacro %}
