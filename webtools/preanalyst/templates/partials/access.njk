{#
  The parts of the page that concern logging in.

  `header` is the state shown in the header. It is needed at two moments: when the
  page is rendered, and when the browser asks for it again after a login done in
  the separate window (`GET /session-fragment`). It is the **inside** of the
  container: whoever receives it replaces the innerHTML.

  `dialog` is the modal window that opens when, while logged out, somebody tries to
  do something that requires an account (sending the request, uploading a file). It
  does not appear by itself: the click on that action opens it.
#}

{% macro header(access) %}
{%- if access.logged %}
        <span class="header-user">{{ access.name }}</span>
        <a class="text-link" href="/logout">{{ t("preanalyst.access.logout") }}</a>
{%- elif not access.sso_available %}
        <span class="header-user">{{ t("preanalyst.access.unreachable") }}</span>
{%- else %}
        <a class="text-link" href="{{ access.login_url }}"
           data-sso-login="{{ access.login_url }}" target="_blank">{{ t("preanalyst.access.login") }}</a>
{%- endif %}
{%- endmacro %}

{#- `id` is used by whoever opens it; `lead` says what is needed and why; `hint`
    what happens after the login. With the sso unreachable there is nothing to
    offer: that is said, and nothing else. #}
{% macro dialog(access, id, lead, hint) %}
      <dialog class="card login-dialog" id="{{ id }}" aria-labelledby="{{ id }}-title">
        <div class="card-head login-dialog-head" id="{{ id }}-title">{{ t("preanalyst.dialogs.title") }}</div>
        <div class="login-dialog-body">
{%- if not access.sso_available %}
          <p class="login-dialog-lead">{{ t("preanalyst.dialogs.unavailable_lead") }}</p>
          <p class="login-dialog-hint">{{ t("preanalyst.dialogs.unavailable_hint") }}</p>
{%- else %}
          <p class="login-dialog-lead">{{ lead }}</p>
          <p class="login-dialog-actions">
            <a class="btn btn-primary" href="{{ access.login_url }}"
               data-sso-login="{{ access.login_url }}" target="_blank">{{ t("preanalyst.access.login") }}</a>
            <a class="text-link" href="{{ access.register_url }}"
               data-sso-login="{{ access.register_url }}" target="_blank">{{ t("preanalyst.access.register") }}</a>
          </p>
          <p class="login-dialog-hint">{{ hint }}</p>
{%- endif %}
          <form method="dialog" class="login-dialog-close">
            <button class="btn" type="submit">{{ t("preanalyst.dialogs.close") }}</button>
          </form>
        </div>
      </dialog>
{%- endmacro %}
