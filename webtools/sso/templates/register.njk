{% extends "commons/base.njk" %}

{# La registrazione non è ancora attiva: la pagina esiste per dirlo, e perché il
   posto dove andrà sia già al suo posto. #}

{% block main %}
    <div class="container access">
      <div class="access-card card">
        <div class="card-head">Registrati</div>
        <div class="access-body">
          <p class="access-lead">
            La registrazione non è ancora attiva: per ora gli account li creiamo noi.
          </p>
          <p class="access-alt">
            <a class="text-link" href="/ui/login?next={{ next | urlencode }}">Torna al login</a>
          </p>
        </div>
      </div>
    </div>
{% endblock %}
