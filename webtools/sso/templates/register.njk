{% extends "commons/base.njk" %}

{# La registrazione non è ancora attiva: la pagina esiste per dirlo, e perché il
   posto dove andrà sia già al suo posto. #}

{% block main %}
    <div class="container access">
      <div class="access-card card">
        <div class="card-head">{{ t("sso.register.title") }}</div>
        <div class="access-body">
          <p class="access-lead">
            {{ t("sso.register.closed") }}
          </p>
          <p class="access-alt">
            <a class="text-link" href="/ui/login?next={{ next | urlencode }}">{{ t("sso.register.back_to_login") }}</a>
          </p>
        </div>
      </div>
    </div>
{% endblock %}
