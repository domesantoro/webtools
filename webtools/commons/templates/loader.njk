{#
  The veil that covers the page while a request is on its way.

  DO NOT EDIT THE COPY INSIDE A SUBSYSTEM.
  The original is `webtools/commons/templates/loader.njk`; the copies are
  distributed by `webtools/configurator/template_deployer/deploy.sh`.

  Used like this:

      {% include "commons/loader.njk" %}

  and the form that should raise it is marked `data-webtools-loader`. It is raised
  by `webtools/commons/script/webtools_loader.js`, distributed by the
  script_deployer and loaded by the page in the `scripts` block.

  Expected variables: `t`, the translation (given by i18n.pageContext).
#}
<div class="webtools-loader" id="webtools-loader" role="status" aria-live="polite" aria-hidden="true">
  <div class="webtools-loader-box">
    <div class="webtools-loader-spinner"></div>
    <p class="webtools-loader-text">{{ t("common.loader.working") }}</p>
  </div>
</div>
